<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.zhangchaosd.ipv6who</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/ipv6who</string>
		<string>--listen</string>
		<string>[::]:8066</string>
		<!-- Client networks allowed to connect; comma separated. -->
		<string>--allow</string>
		<string>::1/128,127.0.0.0/8</string>
	</array>
	<!-- Optional bearer token:
	<key>EnvironmentVariables</key>
	<dict>
		<key>IPV6WHO_TOKEN</key>
		<string>change-me</string>
	</dict>
	-->
	<!-- Run unprivileged. -->
	<key>UserName</key>
	<string>nobody</string>
	<key>GroupName</key>
	<string>nobody</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/ipv6who.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/ipv6who.log</string>
</dict>
</plist>
